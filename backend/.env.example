# ---- Database ----
DATABASE_URL=postgresql+psycopg2://fraud_user:fraud_pass@localhost:5432/fraud_db

# ---- Notifications ----
# true  = alerts are logged + stored locally (no AWS needed)
# false = alerts are sent through AWS (see NOTIFY_CHANNEL)
DEMO_MODE=true
NOTIFY_CHANNEL=sns
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=
SES_SENDER_EMAIL=
SES_RECIPIENT_EMAIL=

# ---- Risk levels / flagging (all configurable) ----
RISK_MEDIUM_MIN=30
RISK_HIGH_MIN=60
RISK_CRITICAL_MIN=80
# score at which a transaction becomes FLAGGED
FRAUD_THRESHOLD=30
# score at which an AWS alert is sent
ALERT_THRESHOLD=80

# ---- Rule settings (each rule reads its own) ----
VELOCITY_MAX_TXNS=6
VELOCITY_WINDOW_MINUTES=5
VELOCITY_POINTS=30
AMOUNT_MULTIPLIER=5
AMOUNT_MIN_HISTORY=3
AMOUNT_FALLBACK_THRESHOLD=50000
AMOUNT_POINTS=40
GEO_MAX_SPEED_KMH=900
GEO_MIN_DISTANCE_KM=50
GEO_POINTS=30
# Comma-separated rule names to switch off, e.g. impossible_geography
DISABLED_RULES=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
